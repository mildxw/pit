<Page x:Class="PitPr4.App.DPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="d: если x &gt; y — (f(x)−y)³ + arctg f(x); если y &gt; x — (y−f(x))³ + arctg f(x); если y = x — (y+f(x))³ + 0,5. f(x): sh(x), x² или e^x." />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,4">x</TextBlock>
                <TextBox x:Name="TxtX" Grid.Row="0" Grid.Column="1" Margin="8,4" ToolTipService.ToolTip="x для f(x) и сравнения с y" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4">y</TextBlock>
                <TextBox x:Name="TxtY" Grid.Row="1" Grid.Column="1" Margin="8,4" ToolTipService.ToolTip="сравнивается с x" />
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4">f(x)</TextBlock>
                <ComboBox x:Name="CmbF" Grid.Row="2" Grid.Column="1" Margin="8,4"
                          ToolTipService.ToolTip="Выберите вид f(x)"
                          SelectedIndex="0">
                    <ComboBoxItem Content="sh(x)" Tag="Sh" />
                    <ComboBoxItem Content="x²" Tag="Square" />
                    <ComboBoxItem Content="e^x" Tag="Exp" />
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Вычислить d" Width="140" Click="BtnCalc_OnClick"
                        ToolTipService.ToolTip="Посчитать d по выбранной ветке" />
            </StackPanel>
            <TextBlock x:Name="TxtResult" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
